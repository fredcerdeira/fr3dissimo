{
  "$collection": "Theme Primitives",
  "$modes": ["Classic", "Alternative"],
  "$source": "Figma: Fred's Playground (29HCuuNGbeWkFdUy6dHEsR), page 'fr3dissimo Tokens'",
  "$note": "Values are per theme. Alternative values are placeholders until chosen.",

  "brand": {
    "accent": {
      "$type": "color", "$css": "--brand-accent",
      "$value": { "Classic": "#ff6b2c", "Alternative": "#3ddc97" }
    },
    "accent-on-paper": {
      "$type": "color", "$css": "--brand-accent-on-paper",
      "$value": { "Classic": "#b8400c", "Alternative": "#1f8a5b" }
    },
    "accent-ink": {
      "$type": "color", "$css": "--brand-accent-ink",
      "$value": { "Classic": "#111112", "Alternative": "#0b1020" }
    }
  },

  "neutral": {
    "night": {
      "$type": "color", "$css": "--neutral-night",
      "$value": { "Classic": "#0b0b0c", "Alternative": "#0b1020" }
    },
    "raised": {
      "$type": "color", "$css": "--neutral-raised",
      "$value": { "Classic": "#131315", "Alternative": "#121a2e" }
    },
    "deep": {
      "$type": "color", "$css": "--neutral-deep",
      "$value": { "Classic": "#1b1b1e", "Alternative": "#1b2540" }
    },
    "chalk": {
      "$type": "color", "$css": "--neutral-chalk",
      "$value": { "Classic": "#f2f1ec", "Alternative": "#eef3fb" }
    },
    "dust": {
      "$type": "color", "$css": "--neutral-dust",
      "$value": { "Classic": "#a3a29c", "Alternative": "#9aa6bf" }
    },
    "bib": {
      "$type": "color", "$css": "--neutral-bib",
      "$value": { "Classic": "#111112", "Alternative": "#0b1020" }
    },
    "pencil": {
      "$type": "color", "$css": "--neutral-pencil",
      "$value": { "Classic": "#5d5c57", "Alternative": "#4b5670" }
    },
    "paper-tint": {
      "$type": "color", "$css": "--neutral-paper-tint",
      "$value": { "Classic": "rgba(17,17,18,0.05)", "Alternative": "rgba(11,16,32,0.05)" }
    },
    "hairline-on-dark": {
      "$type": "color", "$css": "--neutral-hairline-on-dark",
      "$value": { "Classic": "rgba(242,241,236,0.14)", "Alternative": "rgba(238,243,251,0.14)" }
    },
    "hairline-on-paper": {
      "$type": "color", "$css": "--neutral-hairline-on-paper",
      "$value": { "Classic": "rgba(17,17,18,0.15)", "Alternative": "rgba(11,16,32,0.15)" }
    }
  },

  "font": {
    "display": {
      "$type": "fontFamily", "$css": "--font-display",
      "$fallback": ", \"Arial Narrow\", sans-serif",
      "$value": { "Classic": "\"Archivo\"", "Alternative": "\"Oswald\"" }
    },
    "sans": {
      "$type": "fontFamily", "$css": "--font-sans",
      "$fallback": ", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "$value": { "Classic": "\"Barlow\"", "Alternative": "\"Inter\"" }
    },
    "mono": {
      "$type": "fontFamily", "$css": "--font-mono",
      "$fallback": ", ui-monospace, Menlo, monospace",
      "$value": { "Classic": "\"Space Mono\"", "Alternative": "\"JetBrains Mono\"" }
    }
  }
}
